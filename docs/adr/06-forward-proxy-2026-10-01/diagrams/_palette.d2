classes: {
  step:  { shape: rectangle; style.border-radius: 8; style.fill: "#eef4fb"; style.stroke: "#1f3a5f" }
  dec:   { shape: diamond;   style.fill: "#fff7e8"; style.stroke: "#b3760a" }
  ins:   { shape: rectangle; style.border-radius: 8; style.fill: "#e3f6ec"; style.stroke: "#2e9e63" }
  upd:   { shape: rectangle; style.border-radius: 8; style.fill: "#e6efff"; style.stroke: "#3b6fce" }
  del:   { shape: rectangle; style.border-radius: 8; style.fill: "#fdeef1"; style.stroke: "#c0455e" }
  skip:  { shape: rectangle; style.border-radius: 8; style.fill: "#ececec"; style.stroke: "#7a7a7a" }
  term:  { shape: hexagon;   style.fill: "#efe6ff"; style.stroke: "#7d4fce" }
  tbl:   { shape: cylinder;  style.fill: "#1f3a5f"; style.font-color: "#ffffff"; style.stroke: "#11233d" }
  write: { shape: cylinder;  style.fill: "#7d4fce"; style.font-color: "#ffffff"; style.stroke: "#4f2e8e" }
  q:     { shape: queue;     style.fill: "#f5a623"; style.font-color: "#3a2a00"; style.stroke: "#b3760a" }
  ext:   { shape: hexagon;   style.fill: "#ececec"; style.stroke: "#7a7a7a" }
}
